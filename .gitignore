# Zig build output, cache, and fetched dependencies (deps come from build.zig.zon)
zig-out/
.zig-cache/
zig-cache/
zig-pkg/

# toolchains the installer / build scripts bootstrap into the tree (lib-deps.sh)
.zig/
.zig-dl/
.neuron-src/
rustup-init.exe

# Python bytecode (the example fixtures under examples/ are still Python)
__pycache__/
*.py[cod]

# Runtime: per-run swarm dirs (work, sqlite memory, event streams)
data/

# Captured training sets ("build dataset"). These live at {data}/sets/ — already covered by data/
# above — but NL_SETS_DIR can point anywhere, including the repo root, and a set is multi-MB of
# verbatim conversation content: never committable, and never something to leak into a PR by accident.
sets/

# Runtime neuron-db files a local dev run drops at the repo root
neurons.db
neurons.db-*

# Fleet-console roster/audit snapshot — runtime state, not source
hub_state.json
hub_state.json.tmp

# Example run outputs — the embedded harnesses write forensics here per run.
examples/embedded/debug/
examples/**/data/

# Secrets — never commit. Keys live here or in the environment.
keys.env
*.key
.env
.env.*
!.env.example

# The neuron memory-engine binary is a build artifact / release asset, not source.
# Place it at bin/neuron[.exe] (ships prebuilt in the release bundle).
bin/*
!bin/.gitkeep

# neuron-db source + target compiled from the sibling repo when building the engine
.neuron-src/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
SWARM_VCS_BLUEPRINT.md

# raylib F12 default screenshots (veil-desk uses F12 for the log overlay)
screenshot*.png

# release bundles produced by scripts/build-release.* (build output, not source)
dist/

# stray local agent/editor dirs. Local AI tooling stays local: skills, prompts and any
# self-improvement scaffolding are a workstation concern, never part of the shipped repo.
.codex/
.claude/
.agents/

# release build staging (scripts/build-official.sh) — never committed
.release-stage/

# runtime server config written next to the CWD when veil is launched from the repo root
# (the real one lives in data/server-config.json; this copy is an artifact, not source)
server-config.json

# harness growth artifacts (examples/embedded) - growth period is over.
harness/*
# ...except the test doctrine, which is repo documentation and has been tracked since e13f8d1.
# It stays tracked either way (.gitignore does not untrack), so this negation exists to make the
# rule honest rather than leave a file the ignore claims to exclude but git keeps publishing.
!harness/TESTING.md

# local model development artifacts and build design
model/*

# various debugger / profiler / runtime artifacts that are not source
debug.ps1
