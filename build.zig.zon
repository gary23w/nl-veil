.{
    .name = .veil,
    .version = "1.0.1-beta-1",
    .fingerprint = 0xd137d40acdb7c43e,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Vendored (was git+https://github.com/karlseguin/http.zig#20076ad8) so a local patch survives: httpz's
        // blocking-worker read loop spun a thread at 100% CPU on a half-closed (FIN'd) socket — see
        // vendor/httpz/src/request.zig. A gitignored zig-pkg fetch would drop the patch on every re-resolve.
        .httpz = .{
            .path = "vendor/httpz",
        },
        // raylib-zig — the GUI toolkit behind the in-process desk (desk/src/*, linked into `veil` itself so
        // the release ships ONE binary). Kept in sync with desk/build.zig.zon, which still builds veil-desk
        // standalone for development.
        //
        // LAZY on purpose: `zig build -Dapp=false` (the headless/server-only build) must never so much as
        // FETCH raylib, let alone link GL/X11. b.lazyDependency below is only reached when the app option is
        // on, so a GL-free box resolves this package with nothing but vendor/httpz.
        .raylib_zig = .{
            .url = "git+https://github.com/raylib-zig/raylib-zig#97be2c7ae646a2f09856604b138c427c0af1b952",
            .hash = "raylib_zig-6.0.0-KE8REDJ4BQBu7lKwYNt6R4j5ywPeS37zqW6zrtjCcRwH",
            .lazy = true,
        },
        // The embedded inference library behind the BUILT-IN model engine (-Dbuiltin, default true):
        // ggml + llama compiled straight into `veil` (CPU backend only), the same
        // compile-the-C-in pattern as vendor/lua — but fetched, not vendored, because it is ~15MB
        // of source the repo should not carry. Pinned to a release tag; the veil_ll_* shim
        // (src/worker/llamashim.c) turns any upstream API drift into a compile error at bump time.
        // LAZY so `-Dbuiltin=false` (and dependency resolution on boxes that never build it) skips
        // the fetch entirely, exactly like raylib for -Dapp=false.
        .llama_cpp = .{
            .url = "https://github.com/ggml-org/llama.cpp/archive/refs/tags/b10205.tar.gz",
            .hash = "N-V-__8AAATougkyBgkEUyIB0p6OIvQe9n-O1DPDXPIvSZ_Z",
            .lazy = true,
        },
        // The GPU (Vulkan) tier of the built-in engine (-Dvulkan, default true off macOS).
        // veil_vulkan_shaders is OUR pre-generated artifact (a build-assets release on this very
        // repo): the backend's 134 compute shaders compiled to embedded SPIR-V once, with the
        // define set build.zig's addVulkan mirrors — so user/CI builds never need a Vulkan SDK or
        // glslc. Regenerate + republish when the llama_cpp pin changes (release notes say how).
        // vulkan_headers is the matching Khronos header-only package; no import library is linked
        // anywhere — the backend dlopens the runtime loader, so GPU-less machines still boot.
        .veil_vulkan_shaders = .{
            .url = "https://github.com/gary23w/nl-veil/releases/download/builtin-assets-b10205/veil-vulkan-shaders-b10205.tar.gz",
            .hash = "N-V-__8AAD6zbAyRnTagRx-GpjW08tC8BS_28BrLt5ZP_1k0",
            .lazy = true,
        },
        .vulkan_headers = .{
            .url = "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-1.4.350.0.tar.gz",
            .hash = "N-V-__8AAPnEbQK6L3hGtJefy0xZjeg7KOxIEj8_obZC2_lF",
            .lazy = true,
        },
        .spirv_headers = .{
            .url = "https://github.com/KhronosGroup/SPIRV-Headers/archive/refs/tags/vulkan-sdk-1.4.350.0.tar.gz",
            .hash = "N-V-__8AAOWAPQDTQrudoJ1kyAzjkh3mLopx0pq3uHSy2LDi",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "desk",
        "models.yaml",
        "vendor",
        "web",
        "LICENSE",
        "README.md",
    },
}
