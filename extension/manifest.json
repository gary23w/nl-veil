{
  "manifest_version": 3,
  "name": "nl-veil browser link",
  "version": "0.2.1",
  "description": "Lets a local nl-veil server, or the nl-veil web chat when you allow it, drive one tab in this browser with your own logins.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://gary23w.github.io/nl-veil/chat/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "nl-veil browser link"
  },
  "minimum_chrome_version": "116"
}
